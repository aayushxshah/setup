#!/usr/bin/env bash

set -e

OS="$(uname -s)"

if [ "$OS" != "Darwin" ] && [ "$OS" != "Linux" ]; then
  echo "Unsupported operating system: $OS"
  exit 1
fi

# Language installation flags
INSTALL_RUST=false
INSTALL_GO=false
INSTALL_NODE=false
INSTALL_PYTHON=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --rust)
      INSTALL_RUST=true
      shift
      ;;
    --go)
      INSTALL_GO=true
      shift
      ;;
    --node)
      INSTALL_NODE=true
      shift
      ;;
    --python)
      INSTALL_PYTHON=true
      shift
      ;;
    --all)
      INSTALL_RUST=true
      INSTALL_GO=true
      INSTALL_NODE=true
      INSTALL_PYTHON=true
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [--rust] [--go] [--node] [--python] [--all]"
      exit 1
      ;;
  esac
done

# If no arguments provided, prompt user interactively
if [ "$INSTALL_RUST" = false ] && [ "$INSTALL_GO" = false ] && [ "$INSTALL_NODE" = false ] && [ "$INSTALL_PYTHON" = false ]; then
  echo "Which languages would you like to install?"
  read -p "Install Rust? (y/n) " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]] && INSTALL_RUST=true

  read -p "Install Go? (y/n) " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]] && INSTALL_GO=true

  read -p "Install Node.js? (y/n) " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]] && INSTALL_NODE=true

  read -p "Install Python tools (uv)? (y/n) " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]] && INSTALL_PYTHON=true
fi

echo ""
echo "Installation configuration:"
echo "  Rust: $INSTALL_RUST"
echo "  Go: $INSTALL_GO"
echo "  Node.js: $INSTALL_NODE"
echo "  Python: $INSTALL_PYTHON"
echo ""

function link() {
  local src="$1"
  local target="$2"
  if [ -L "$target" ]; then
    : # already a symlink, leave it
  elif [ -e "$target" ]; then
    echo "Skipping $target — already exists as a real file/directory (remove it manually to link)"
  else
    ln -s "$src" "$target"
  fi
}

# Install or skip if already installed
function brew_install() {
  local package="$1"
  if brew list "$package" &>/dev/null; then
    echo "$package already installed"
  else
    echo "Installing $package..."
    brew install "$package"
  fi
}

if [ "$OS" = "Linux" ]; then
  if [ ! -f /etc/os-release ] || ! grep -Eq '^(ID|ID_LIKE)=.*ubuntu' /etc/os-release; then
    echo "Warning: this Linux installer is tested on Ubuntu only."
  fi

  echo "Installing Ubuntu prerequisites..."
  sudo apt-get update
  sudo apt-get install -y build-essential procps curl file git zsh
fi

echo "Checking for Homebrew..."
if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  echo "Homebrew already installed"
fi

# Homebrew is installed outside the default PATH on a fresh Ubuntu system.
if [ "$OS" = "Linux" ] && [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ "$OS" = "Darwin" ] && [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if ! command -v brew &>/dev/null; then
  echo "Homebrew was installed but could not be found on PATH."
  exit 1
fi

# Check for SSH key
echo ""
echo "Checking for SSH key..."
if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
  echo "No SSH key found at ~/.ssh/id_ed25519"
  read -p "Enter your email for the SSH key: " email
  if [ -z "$email" ]; then
    echo "Error: Email is required to generate SSH key"
    exit 1
  fi

  mkdir -p "$HOME/.ssh"
  ssh-keygen -t ed25519 -C "$email" -f "$HOME/.ssh/id_ed25519" -N ""
  chmod 600 "$HOME/.ssh/id_ed25519"
  chmod 644 "$HOME/.ssh/id_ed25519.pub"

  echo "SSH key generated successfully at ~/.ssh/id_ed25519"
  echo "Public key:"
  cat "$HOME/.ssh/id_ed25519.pub"
else
  echo "SSH key already exists at ~/.ssh/id_ed25519"
fi

echo "Install required packages via Homebrew"
brew_install fzf
brew_install jq
brew_install eza
brew_install bat
brew_install ripgrep
brew_install xh
brew_install zellij
brew_install zoxide
brew_install difftastic
brew_install starship
brew_install neovim
brew_install zsh-autosuggestions
brew_install worktrunk
brew_install just
brew_install bottom

# Check for uv (Python package installer)
if [ "$INSTALL_PYTHON" = true ]; then
  uv_bin=$(which uv 2>/dev/null)
  if [ ! -x "$uv_bin" ]; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh || (echo "uv not found and not able to install" && exit 1)
    export PATH="$HOME/.local/bin:$PATH"
  else
    echo "uv already installed"
  fi

fi

# Check for Go
if [ "$INSTALL_GO" = true ]; then
  go_bin=$(which go 2>/dev/null)
  if [ ! -x "$go_bin" ]; then
    echo "Installing Go..."
    brew_install go
  else
    echo "go already installed"
  fi
fi

# Install Node.js without a shell version manager
if [ "$INSTALL_NODE" = true ]; then
  brew_install node

  if ! command -v yarn &>/dev/null; then
    echo "Installing Yarn..."
    npm install -g yarn
  fi

  if ! command -v tsc &>/dev/null; then
    echo "Installing TypeScript..."
    npm install -g typescript
  fi
fi

dev_dir=$(dirname "$(realpath "$0")")
mkdir -p "$HOME/.dev"
link "$dev_dir/aliases" "$HOME/.dev/aliases"
link "$dev_dir/zshrc" "$HOME/.zshrc"
link "$dev_dir/devrc" "$HOME/.devrc"

# Install git
link "$dev_dir/gitconfig" "$HOME/.gitconfig"

mkdir -p "$HOME/.config"
link "$dev_dir/vimrc" "$HOME/.vimrc"
link "$dev_dir/nvim" "$HOME/.config/nvim"
if [ ! -f "$HOME/.vim/colors/solarized.vim" ]; then
  echo "Installing solarized vim colors"
  curl -fsSL https://raw.github.com/altercation/vim-colors-solarized/master/colors/solarized.vim -o solarized.vim
  mkdir -p "$HOME/.vim/colors"
  mv solarized.vim "$HOME/.vim/colors"
fi

# Configure starship
link "$dev_dir/starship.toml" "$HOME/.config/starship.toml"

echo "dev installation complete"
echo "source your .zshrc or exit the shell to reload your configuration"
